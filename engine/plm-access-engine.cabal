cabal-version:      2.4
name:               plm-access-engine
version:            0.1.0
synopsis:           A rule-based access engine for PLM product trees, with a reliability harness.
build-type:         Simple

common warnings
    ghc-options: -Wall -Wcompat -Wincomplete-record-updates
                 -Wincomplete-uni-patterns -Wredundant-constraints

library
    import:           warnings
    default-language: Haskell2010
    hs-source-dirs:   src
    exposed-modules:  PLM.Types
                      PLM.Engine
                      PLM.Eval
                      PLM.Json
    build-depends:    base >=4.17 && <5
                    , containers
                    , text
                    , aeson >=2.3 && <2.4

executable plm-access
    import:           warnings
    default-language: Haskell2010
    hs-source-dirs:   app
    main-is:          Main.hs
    build-depends:    base
                    , bytestring
                    , containers
                    , text
                    , aeson >=2.3 && <2.4
                    , plm-access-engine

benchmark bench
    import:           warnings
    default-language: Haskell2010
    type:             exitcode-stdio-1.0
    hs-source-dirs:   bench
    main-is:          Bench.hs
    build-depends:    base
                    , containers
                    , text
                    , plm-access-engine

test-suite spec
    import:           warnings
    default-language: Haskell2010
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Spec.hs
    other-modules:    PLM.Arbitrary
                      PLM.EngineSpec
                      PLM.EvalSpec
                      PLM.JsonSpec
    build-depends:    base
                    , containers
                    , text
                    , aeson >=2.3 && <2.4
                    , plm-access-engine
                    , hspec
                    , QuickCheck
    build-tool-depends: hspec-discover:hspec-discover
